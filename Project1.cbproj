    <Target Name="MapManagerArchiveDelphiObjects" BeforeTargets="_CheckLinkDependencies" Condition="'$(Platform)'=='Win32' Or '$(Platform)'=='Win64'">
        <Exec Command="&quot;$(MSBuildProjectDirectory)\build\compile-archive-units.cmd&quot; &quot;$(Platform)&quot; &quot;$(Config)&quot;"/>
    </Target>
    <Target Name="MapManagerStageResourceWin64x" BeforeTargets="_CheckLinkDependencies" Condition="'$(Platform)'=='Win64x'">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Project1.res"
              DestinationFiles="$(MSBuildProjectDirectory)\Win64x\$(Config)\Project1.res"
              Condition="Exists('$(MSBuildProjectDirectory)\Project1.res') And !Exists('$(MSBuildProjectDirectory)\Win64x\$(Config)\Project1.res')" />
    </Target>
    <Target Name="MapManagerStageLegacyXMLWin64x" BeforeTargets="_CheckLinkDependencies" Condition="'$(Platform)'=='Win64x'">
        <!-- Preserve existing runtime settings. Only stage the recovered XML
             when no user-specific settings file exists in the output folder. -->
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Settings\Settings.xml"
              DestinationFiles="$(MSBuildProjectDirectory)\Win64x\$(Config)\Settings\Settings.xml"
              Condition="Exists('$(MSBuildProjectDirectory)\Settings\Settings.xml') And !Exists('$(MSBuildProjectDirectory)\Win64x\$(Config)\Settings\Settings.xml')" />
    </Target>
    <Target Name="MapManagerStageDatabaseTemplatesWin64x" BeforeTargets="_CheckLinkDependencies" Condition="'$(Platform)'=='Win64x'">
        <MakeDir Directories="$(MSBuildProjectDirectory)\Win64x\$(Config)\Database\templates" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Database\templates\settings.sqlite3;$(MSBuildProjectDirectory)\Database\templates\cache.sqlite3;$(MSBuildProjectDirectory)\Database\templates\logs.sqlite3"
              DestinationFolder="$(MSBuildProjectDirectory)\Win64x\$(Config)\Database\templates"
              SkipUnchangedFiles="true" />
    </Target>
    <Target Name="MapManagerStage7ZipWin64Runtime" AfterTargets="_PerformLink" Condition="'$(Platform)'=='Win64x'">
        <Copy SourceFiles="C:\Program Files\7-Zip\7z.dll" DestinationFiles="$(MSBuildProjectDirectory)\Win64x\$(Config)\7z.dll" SkipUnchangedFiles="true" Condition="Exists('C:\Program Files\7-Zip\7z.dll')"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Cpp.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Cpp.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
</Project>
