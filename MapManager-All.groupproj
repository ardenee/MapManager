  <Target Name="TUTPackageNative:Make">
    <MSBuild Projects="..\TUTPackage\TUTPackageNative.dproj" Targets="Make" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="MapManagerArchiveNative:Make">
