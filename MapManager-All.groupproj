      <Dependencies />
    </Projects>
    <Projects Include="Project1.cbproj">
      <Dependencies />
    </Projects>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Default.Personality.12</Borland.Personality>
    <Borland.ProjectType />
  </ProjectExtensions>
  <Target Name="TUTPackageNative">
    <MSBuild Projects="..\TUTPackage\TUTPackageNative.dproj" Targets="Build" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="TUTPackageNative:Clean">
    <MSBuild Projects="..\TUTPackage\TUTPackageNative.dproj" Targets="Clean" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="MapManagerArchiveNative">
    <MSBuild Projects="..\d7zip\MapManagerArchiveNative.dproj" Targets="Build" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="MapManagerArchiveNative:Clean">
    <MSBuild Projects="..\d7zip\MapManagerArchiveNative.dproj" Targets="Clean" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="VirtualTreesCR">
    <MSBuild Projects="..\Virtual-TreeView\Packages\CBuilder 13\VirtualTreesCR.dproj" Targets="Build" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="VirtualTreesCR:Clean">
    <MSBuild Projects="..\Virtual-TreeView\Packages\CBuilder 13\VirtualTreesCR.dproj" Targets="Clean" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="MapManagerApp">
    <MSBuild Projects="Project1.cbproj" Targets="Build" Properties="Config=$(Config);Platform=$(Platform)" />
  </Target>
  <Target Name="MapManagerApp:Clean">
