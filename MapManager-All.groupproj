<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{54E916B2-F127-4F28-8F77-746743478B8B}</ProjectGuid>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64x</Platform>
  </PropertyGroup>
  <ItemGroup>
    <Projects Include="..\TUTPackage\TUTPackageNative.dproj">
      <Dependencies />
    </Projects>
    <Projects Include="..\d7zip\MapManagerArchiveNative.dproj">
      <Dependencies />
